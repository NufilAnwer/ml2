# ============================================================
# VisionGuard Environment Variables - COPY TO .env AND FILL
# ============================================================

# --- Flask ---
FLASK_ENV=production
FLASK_SECRET_KEY=change_me_to_a_long_random_string
DEBUG=False

# --- Model ---
MODEL_PATH=models/champion_model.keras
DECISION_THRESHOLD=0.5
MAX_CONTENT_LENGTH=10485760

# --- Database ---
DATABASE_URL=sqlite:///visionguard.db

# --- MLflow / DagsHub ---
MLFLOW_TRACKING_URI=https://dagshub.com/NufilAnwer/ml2.mlflow
MLFLOW_TRACKING_USERNAME=NufilAnwer
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here

# --- Cloud API (Task 7) ---
CLOUD_API_URL=http://localhost:5001
CLOUD_API_SECRET=your_api_secret_here

# --- PostgreSQL (for Docker Compose) ---
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

